# secureblue Trivalent supply-chain trust anchors.
# This is the ONLY file in the repo that carries the hard-coded fingerprint.
# Every other script sources it; nothing hard-codes these values inline.
#
# Changing SECUREBLUE_FPR (or SECUREBLUE_GPG_SHA256) REQUIRES, in the same commit:
#   - a new dated entry in ../KEY-PROVENANCE.md
#   - that entry citing >= 2 independent acquisition channels showing the new value
#   - a human name against the confirmation
# A key-fingerprint change is indistinguishable from key theft (failure mode F1):
# it is never adopted automatically. See 00-bootstrap-key.sh.
#
# Channel 1 (source repo):   secureblue/Trivalent  .github/workflows/build.yml
#                            -> %_gpg_name 26B4463ED8F313BC7E3FBDF9D9223AF0F47B3E41
#                            -> gpg --detach-sign --local-user 26B4463ED8F313BC7E3FBDF9D9223AF0F47B3E41
# Channel 2 (key bytes):     secureblue.gpg, sha256 40d8ad27...d555, byte-identical at
#                            - https://repo.secureblue.dev/secureblue.gpg
#                            - secureblue/secureblue :: files/system/desktop/usr/share/pki/rpm-gpg/secureblue.gpg
# See KEY-PROVENANCE.md for the dated confirmation record.

# GPG primary-key fingerprint of the secureblue RPM/repodata signing key.
SECUREBLUE_FPR=26B4463ED8F313BC7E3FBDF9D9223AF0F47B3E41

# sha256 of the ASCII/binary secureblue.gpg public-key file as published.
SECUREBLUE_GPG_SHA256=40d8ad2714bb09873153668d9c647362acc48677a2c0defb0c7d6576041fd555

# SLSA provenance pins (failure mode F2 lives here: if upstream leaves
# slsa-github-generator, these stop matching and 10-verify-supply-chain.sh
# reports "format changed", not "provenance missing").
SLSA_SOURCE_URI=github.com/secureblue/Trivalent
SLSA_SOURCE_BRANCH=live
SLSA_BUILDER_ID=https://github.com/slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@refs/tags/v2.1.0

# Upstream coordinates. These are LOCATIONS, not trust anchors -- overridable
# from the environment so the negative tests (verify/99-negative-tests.sh) can
# point them at local fixtures. The trust anchors above (fingerprint, key
# sha256, SLSA builder id) are NOT overridable.
: "${SECUREBLUE_REPO_BASEURL:=https://repo.secureblue.dev}"
: "${TRIVALENT_GH_REPO:=secureblue/Trivalent}"
: "${SECUREBLUE_GH_REPO:=secureblue/secureblue}"
: "${SECUREBLUE_GPG_COMMITTED_PATH:=files/system/desktop/usr/share/pki/rpm-gpg/secureblue.gpg}"
